# novel_indian_pipeline/.env.example
# Copy to .env and adjust for your environment.
# All paths are absolute. The .env is loaded by env_paths.py at import time.

# ---------------------------------------------------------------------------
# Existing CQT feature directories (read-only; reused, not copied).
# ---------------------------------------------------------------------------
INDIAN_CQT_DIR=/teamspace/studios/this_studio/PP4/indian_new_pipeline/cqt_features
INDIAN_VOCAL_CQT_DIR=/teamspace/studios/this_studio/PP4/indian_vocal_pipeline/cqt_features
SHS100K_CQT_DIR=/teamspace/studios/this_studio/PP4/shs100k_new_pipeline/cqt_features
SHS100K_VOCAL_CQT_DIR=/teamspace/studios/this_studio/PP4/shs100k_vocal_pipeline/cqt_features

# ---------------------------------------------------------------------------
# Manifests (read-only; reused as-is).
# Indian format:   "<filename>,<clique>"            (is_original from filename suffix -o)
# SHS100K format:  "<filename>,<clique>,<is_orig>"  (is_original explicit 0/1)
# ---------------------------------------------------------------------------
INDIAN_TRAIN_TXT=/teamspace/studios/this_studio/PP4/indian_new_pipeline/indian_train.txt
INDIAN_TEST_TXT=/teamspace/studios/this_studio/PP4/indian_new_pipeline/indian_test.txt
INDIAN_VOCAL_TRAIN_TXT=/teamspace/studios/this_studio/PP4/indian_vocal_pipeline/indian_train.txt
INDIAN_VOCAL_TEST_TXT=/teamspace/studios/this_studio/PP4/indian_vocal_pipeline/indian_test.txt
SHS100K_TEST_TXT=/teamspace/studios/this_studio/PP4/shs100k_new_pipeline/shs100k-test.txt
SHS100K_VOCAL_TEST_TXT=/teamspace/studios/this_studio/PP4/shs100k_vocal_pipeline/shs100k-test.txt

# ---------------------------------------------------------------------------
# Warm-start checkpoints (read-only; never overwritten in place).
# ---------------------------------------------------------------------------
INDIAN_CKPT=/teamspace/studios/this_studio/PP4/check_points/CQTNet_indian_dyn_triplet_best_indian_fin_map76.pth
INDIAN_VOCAL_CKPT=/teamspace/studios/this_studio/PP4/check_points/CQTNet_indian_vocal_dyn_triplet_best_vocal_dyn_triplet_ce201641_full.pth
SHS100K_CKPT=/teamspace/studios/this_studio/PP4/check_points/CQTNet_shs100k_mod_triplet_best_shs100k_20260502_184211.pth
SHS100K_VOCAL_CKPT=/teamspace/studios/this_studio/PP4/check_points/CQTNet_shs100k_vocal_dyn_triplet_best_shs100k_vocal_20260502_203445.pth

# ---------------------------------------------------------------------------
# Outputs from this pipeline (writable; created if missing).
# ---------------------------------------------------------------------------
RESULTS_DIR=/teamspace/studios/this_studio/PP4/novel_indian_pipeline/results
LOGS_DIR=/teamspace/studios/this_studio/PP4/novel_indian_pipeline/logs
NEW_CKPT_DIR=/teamspace/studios/this_studio/PP4/novel_indian_pipeline/check_points
TONIC_INDEX_DIR=/teamspace/studios/this_studio/PP4/novel_indian_pipeline/tonic_index
